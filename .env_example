# Mercado Pago credentials — fill these values.
# Source: https://www.mercadopago.com.mx/developers/panel/app -> Credenciales de prueba

# Test credential, e.g. TEST-1234... (or APP_USR-... for production)
MP_ACCESS_TOKEN=YOUR_ACCESS_TOKEN

# Payment currency (MXN, ARS, USD, BRL, ...)
MP_CURRENCY_ID=YOUR_PAYMENT_CURRENCY

# Optional: absolute base URL for back_urls, e.g. http://localhost:3000
# Leave empty to auto-detect from the current request.
MP_BASE_URL=
